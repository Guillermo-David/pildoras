<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.textfield.CustomTextField?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="io.github.guillermo_david.controller.ListadoPildorasController"
            fx:id="root">
    <top>
		<VBox spacing="0">
		  <!-- Title bar fija -->
			<HBox fx:id="titleBar" alignment="CENTER_LEFT" styleClass="titlebar">
			  <Label text="Píldoras" styleClass="titlebar-title"/>
			  <Pane HBox.hgrow="ALWAYS"/>
			
			  <!-- Acciones de la barra -->
				<HBox spacing="8" styleClass="titlebar-actions">
			    	<MenuButton   fx:id="btnSettings" popupSide="BOTTOM" styleClass="icon-btn settings-btn"/>
			    	<Separator orientation="VERTICAL" styleClass="v-sep"/>
			    	<Button fx:id="btnClose" text="✕" styleClass="titlebar-close"/>
				</HBox>
			</HBox>

		
		  <!-- Cabecera con filtros (ocultable) -->
		  <HBox fx:id="appHeader" spacing="10" alignment="CENTER_LEFT" styleClass="app-header">
		    <padding>
		      <Insets top="10" right="10" bottom="10" left="10"/>
		    </padding>
		
		    <ImageView fx:id="imgLogo" fitHeight="64" preserveRatio="true" pickOnBounds="true"/>
		    <Separator orientation="VERTICAL" styleClass="v-sep"/>
		
		    <Label text="Buscar:"/>
		    <CustomTextField fx:id="txtFiltroTexto" promptText="Título o contenido..."/>
		    <Separator orientation="VERTICAL" styleClass="v-sep"/>
		
		    <ToggleButton fx:id="btnSoloFav" styleClass="toggle-btn"/>
		    <Separator orientation="VERTICAL" styleClass="v-sep"/>
		
			<!--Esto empuja-->
		    <!--<Pane HBox.hgrow="ALWAYS"/>-->
		
			<HBox spacing="10" alignment="CENTER_RIGHT">
			    <SplitMenuButton fx:id="btnNueva"/>
		    </HBox>
		
		    <Separator orientation="VERTICAL" styleClass="v-sep"/>
		
		  </HBox>
		</VBox>
	</top>

    <center>
        <HBox>
            <TableView fx:id="table" prefWidth="800" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFav" text=""/>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="200"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="400"/>
                    <TableColumn fx:id="colTags" text="Tags" prefWidth="200"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="105"/>
                </columns>
            </TableView>

            <!-- Panel lateral de tags (derecha) -->
            <VBox fx:id="tagSidebar" styleClass="tag-sidebar" prefWidth="200" minWidth="0" maxWidth="200">
                <HBox alignment="CENTER_LEFT" styleClass="tag-sidebar-header">
                    <padding><Insets top="4" right="10" bottom="4" left="10"/></padding>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnToggleSidebar" text="▶" styleClass="icon-btn sidebar-toggle"/>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="tag-sidebar-scroll">
                    <VBox fx:id="tagListBox" spacing="0" styleClass="tag-sidebar-list"/>
                </ScrollPane>
            </VBox>
        </HBox>
	</center>

	<bottom>
	    <VBox spacing="2" styleClass="bottom-bar">
	        <!-- Paginación -->
	        <HBox fx:id="paginationBox" alignment="CENTER" spacing="6">
	            <padding>
	                <Insets top="4" right="10" bottom="0" left="10"/>
	            </padding>
	            <Button fx:id="btnAnterior"/>
	            <Label fx:id="lblPagina" styleClass="pagination-label"/>
	            <Button fx:id="btnSiguiente"/>
	        </HBox>
	
	        <!-- Barra de estado -->
	        <HBox fx:id="statusBar" alignment="CENTER" spacing="8" styleClass="status-bar">
	            <padding>
	                <Insets top="6" right="12" bottom="8" left="12"/>
	            </padding>
	            <Label fx:id="lblStatus" id="lblStatus" text="" maxWidth="Infinity"/>
	        </HBox>
	    </VBox>
	</bottom>



</BorderPane>
