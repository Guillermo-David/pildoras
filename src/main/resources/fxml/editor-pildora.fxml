<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.ToggleSwitch?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.guillermo_david.controller.EditorPildoraController"
      fx:id="root"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <ToggleSwitch fx:id="switchProteger" text="Proteger contenido"/>
        <ToggleSwitch fx:id="switchOcultar" text="Ocultar píldora"/>
    </HBox>
    <Label fx:id="lblTitle" text="Título:"/>
    <TextField fx:id="txtTitulo"/>


    <Label fx:id="lblContent" text="Contenido (Markdown):"/>
    <ToolBar>
	    <!-- Estilo básico -->
	    <Button text="B"    onAction="#onMd" userData="mdBold" focusTraversable="false"/>
	    <Button text="I"    onAction="#onMd" userData="mdItalic" focusTraversable="false"/>
	    <Button text="~~"   onAction="#onMd" userData="mdStrike" focusTraversable="false"/>
	    <Button text="`"    onAction="#onMd" userData="mdCodeInline" focusTraversable="false"/>
	    <Separator/>
	    <SplitMenuButton fx:id="smbLinks" text="🔗" onAction="#onMd" userData="mdInsertLinkDialog" focusTraversable="false">
		    <items>
		        <MenuItem text="Enlace externo…"    onAction="#onMd" userData="mdInsertLinkDialog"/>
		        <MenuItem text="Enlace a píldora…"  onAction="#onMd" userData="mdInsertInternalLink"/>
		    </items>
		</SplitMenuButton>

	    <Separator/>
	
	    <!-- Encabezados -->
	    <MenuButton fx:id="mbHeadings" text="H#" focusTraversable="false">
	        <items>
	            <MenuItem text="H1" onAction="#onMd" userData="mdH1"/>
	            <MenuItem text="H2" onAction="#onMd" userData="mdH2"/>
	            <MenuItem text="H3" onAction="#onMd" userData="mdH3"/>
	            <SeparatorMenuItem/>
	            <MenuItem text="Quitar encabezado" onAction="#onMd" userData="mdClearHeading"/>
	        </items>
	    </MenuButton>
	
	    <!-- Listas -->
	    <MenuButton fx:id="mbLists" text="Listas" focusTraversable="false">
	        <items>
	            <MenuItem text="• Viñetas"     onAction="#onMd" userData="mdBulletedList"/>
	            <MenuItem text="1. Numerada"   onAction="#onMd" userData="mdNumberedList"/>
	            <MenuItem text="☐ Tareas"      onAction="#onMd" userData="mdTaskList"/>
	        </items>
	    </MenuButton>
	
	    <!-- Bloques -->
	    <MenuButton fx:id="mbBlocks" text="Bloques" focusTraversable="false">
	        <items>
	            <MenuItem text="Cita (>)"        onAction="#onMd" userData="mdBlockquote"/>
	            <MenuItem text="Bloque de código" onAction="#onMd" userData="mdCodeBlock"/>
	            <MenuItem text="Regla ---"        onAction="#onMd" userData="mdHorizontalRule"/>
	            <MenuItem text="Tabla 2×2"        onAction="#onMd" userData="mdTable2x2"/>
	        </items>
	    </MenuButton>
	
	    <!-- Insertar -->
	    <MenuButton fx:id="mbInsert" text="Insertar" focusTraversable="false">
	        <items>
	            <MenuItem text="Enlace…" onAction="#onMd" userData="mdInsertLinkDialog"/>
	            <MenuItem text="Imagen…" onAction="#onMd" userData="mdInsertImageDialog"/>
	        </items>
	    </MenuButton>
	    
	    <!-- Avanzado (requiere extensiones en tu renderer si quieres que se vean chulas) -->
	    <MenuButton fx:id="mbAdvanced" text="Avanzado" focusTraversable="false">
	        <items>
	            <MenuItem text="Nota al pie"     onAction="#onMd" userData="mdFootnote"/>
	            <MenuItem text="Índice (TOC)"    onAction="#onMd" userData="mdInsertTOC"/>
	            <MenuItem text="Math inline $…$" onAction="#onMd" userData="mdMathInline"/>
	            <MenuItem text="Math bloque $$"  onAction="#onMd" userData="mdMathBlock"/>
	        </items>
	    </MenuButton>
	
	    <MenuButton fx:id="mbMath" text="Σ Matemáticas" focusTraversable="false"/>
	    
	
		<Separator/>
	
		<Pane HBox.hgrow="ALWAYS"/>
		<ToggleSwitch fx:id="switchPreview" text="👁 Vista previa" focusTraversable="false"/>
	</ToolBar>

	   
	<SplitPane fx:id="splitEditor" dividerPositions="0.5" VBox.vgrow="ALWAYS">
	    <items>
	        <TextArea fx:id="txtDescripcion" wrapText="true"/>
	        <WebView fx:id="webPreview"/>
	    </items>
	</SplitPane> 
    <Label fx:id="lblCount" styleClass="muted-label"/>

    <Label fx:id="lblTags" text="Tags"/>
	<HBox spacing="8">
	    <TextField fx:id="txtTagInput" promptText="Añade un tag y pulsa Enter…" HBox.hgrow="ALWAYS"/>
	    <FlowPane fx:id="tagsBox" hgap="6" vgap="6" />
	</HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnGuardar" text="💾 Guardar"/>
        <Button fx:id="btnCancelar" text="❌ Cancelar"/>
    </HBox>
</VBox>
