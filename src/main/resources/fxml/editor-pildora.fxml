<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.ToggleSwitch?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.guillermo_david.controller.EditorPildoraController"
      fx:id="root"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <ToggleSwitch fx:id="switchProteger" text="Proteger contenido"/>
    <Label text="Título:"/>
    <TextField fx:id="txtTitulo"/>


    <Label text="Contenido (Markdown):"/>
    <ToolBar>
	    <!-- Estilo básico -->
	    <Button text="B"    onAction="#mdBold"/>
	    <Button text="I"    onAction="#mdItalic"/>
	    <Button text="~~"   onAction="#mdStrike"/>
	    <Button text="`"    onAction="#mdCodeInline"/>
	    <Separator/>
	    <SplitMenuButton text="🔗" onAction="#mdInsertLinkDialog" >
		    <items>
		        <MenuItem text="Enlace externo…"    onAction="#mdInsertLinkDialog"/>
		        <MenuItem text="Enlace a píldora…"  onAction="#mdInsertInternalLink"/>
		    </items>
		</SplitMenuButton>

	    <Separator/>
	
	    <!-- Encabezados -->
	    <MenuButton text="H#">
	        <items>
	            <MenuItem text="H1" onAction="#mdH1"/>
	            <MenuItem text="H2" onAction="#mdH2"/>
	            <MenuItem text="H3" onAction="#mdH3"/>
	            <SeparatorMenuItem/>
	            <MenuItem text="Quitar encabezado" onAction="#mdClearHeading"/>
	        </items>
	    </MenuButton>
	
	    <!-- Listas -->
	    <MenuButton text="Listas">
	        <items>
	            <MenuItem text="• Viñetas"     onAction="#mdBulletedList"/>
	            <MenuItem text="1. Numerada"   onAction="#mdNumberedList"/>
	            <MenuItem text="☐ Tareas"      onAction="#mdTaskList"/>
	        </items>
	    </MenuButton>
	
	    <!-- Bloques -->
	    <MenuButton text="Bloques">
	        <items>
	            <MenuItem text="Cita (>)"        onAction="#mdBlockquote"/>
	            <MenuItem text="Bloque de código" onAction="#mdCodeBlock"/>
	            <MenuItem text="Regla ---"        onAction="#mdHorizontalRule"/>
	            <MenuItem text="Tabla 2×2"        onAction="#mdTable2x2"/>
	        </items>
	    </MenuButton>
	
	    <!-- Insertar -->
	    <MenuButton text="Insertar">
	        <items>
	            <MenuItem text="Enlace…" onAction="#mdInsertLinkDialog"/>
	            <MenuItem text="Imagen…" onAction="#mdInsertImageDialog"/>
	        </items>
	    </MenuButton>
	    
	    <!-- Avanzado (requiere extensiones en tu renderer si quieres que se vean chulas) -->
	    <MenuButton text="Avanzado">
	        <items>
	            <MenuItem text="Nota al pie"     onAction="#mdFootnote"/>
	            <MenuItem text="Índice (TOC)"    onAction="#mdInsertTOC"/>
	            <MenuItem text="Math inline $…$" onAction="#mdMathInline"/>
	            <MenuItem text="Math bloque $$"  onAction="#mdMathBlock"/>
	        </items>
	    </MenuButton>
	
	    <MenuButton fx:id="mbMath" text="Σ Matemáticas"/>
	    
	
		<Separator/>
	
		<Pane HBox.hgrow="ALWAYS"/>
		<ToggleSwitch fx:id="switchPreview" text="👁 Vista previa"/>
	</ToolBar>

	   
	<SplitPane fx:id="splitEditor" dividerPositions="0.5" VBox.vgrow="ALWAYS">
	    <items>
	        <TextArea fx:id="txtDescripcion" wrapText="true"/>
	        <WebView fx:id="webPreview"/>
	    </items>
	</SplitPane> 

    <Label text="Tags"/>
	<HBox spacing="8">
	    <TextField fx:id="txtTagInput" promptText="Añade un tag y pulsa Enter…" HBox.hgrow="ALWAYS"/>
	    <FlowPane fx:id="tagsBox" hgap="6" vgap="6" />
	</HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnGuardar" text="💾 Guardar"/>
        <Button fx:id="btnCancelar" text="❌ Cancelar"/>
    </HBox>
</VBox>
