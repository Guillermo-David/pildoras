<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.guillermo_david.controller.DetallePildoraController"
      fx:id="root"
      spacing="10">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label fx:id="lblTitulo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="lblFecha" style="-fx-text-fill: gray;"/>
    <Label fx:id="lblTags" style="-fx-font-style: italic;"/>

    <Separator/>

    <WebView fx:id="webContenido" VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
	    <Button fx:id="btnBorrar" text="🗑 Borrar" style="-fx-text-fill: red;"/>
	    <Button fx:id="btnEditar" text="✏ Editar"/>
	    <Button fx:id="btnVolver" text="⬅ Volver al listado"/>
	</HBox>


</VBox>
